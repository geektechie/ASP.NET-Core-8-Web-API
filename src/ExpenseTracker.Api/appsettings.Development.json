{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ExpenseTracker": "Debug"
    }
  },

  "//Database": "Switch Provider to 'SqlServer' to use the connection string below; 'InMemory' needs nothing installed.",
  "Database": {
    "Provider": "InMemory"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Your_Connection_String"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  },

  "Tracker": {
    "Currency": "USD",
    "DefaultReportDays": 30,
    "SeedDefaultCategories": true
  }
}
